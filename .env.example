# Copy to .env.local; NEVER commit real secrets.
# `mock` = local/demo/testing without Google Drive, clearly labeled. `google-drive` = real.
STORAGE_MODE=mock
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin auth: generate Argon2id via npm run admin:hash.
# Script saves .env.local automatically; literal $ in .env hashes must be escaped as \$.
ADMIN_PASSWORD_HASH=
# At least 32 cryptographically random bytes of secret material; never use a sample value.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=8

# Google user OAuth credentials (server-side only; required for STORAGE_MODE=google-drive).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Must match OAuth client configuration and OAuth setup CLI callback precisely.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3847/oauth2callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_FRAMES_FOLDER_ID=
GOOGLE_DRIVE_PHOTOS_FOLDER_ID=

# Suggested defaults; exact implemented values may be constrained by hosting platform.
MAX_FINAL_PHOTO_BYTES=12582912
MAX_FRAME_OVERLAY_BYTES=8388608
MAX_FRAME_PIXEL_COUNT=30000000
# Optional absolute paths; empty uses the bundled npm binaries.
# Ubuntu production: apt install ffmpeg; use /usr/bin/ffmpeg and /usr/bin/ffprobe.
FFMPEG_PATH=
FFPROBE_PATH=
# Listing dan asset proxy menggunakan no-store; tidak ada TTL cache pada MVP.

# Atur WAF/rate limiting di trusted reverse proxy untuk event publik.
